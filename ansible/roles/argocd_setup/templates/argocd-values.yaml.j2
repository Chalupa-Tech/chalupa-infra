configs:
  cm:
    url: https://argocd.chalupatech.com
    admin.enabled: true
    oidc.config: |
      name: OpenBao
      issuer: https://openbao.chalupatech.com/v1/identity/oidc/provider/default
      clientID: {{ argocd_setup_oidc_client_id | default('placeholder', true) }}
      clientSecret: $oidc.openbao.clientSecret
      requestedScopes: ["openid", "user"]
      requestedIDTokenClaims: {"username": {"essential": true}}

    # StatefulSet volumeClaimTemplates: K8s adds apiVersion, kind, status,
    # and volumeMode after creation. Known ArgoCD issue since 2019 (#1729).
    resource.customizations.ignoreDifferences.apps_StatefulSet: |
      jqPathExpressions:
        - .spec.volumeClaimTemplates[]?.apiVersion
        - .spec.volumeClaimTemplates[]?.kind
        - .spec.volumeClaimTemplates[]?.status
        - .spec.volumeClaimTemplates[].spec.volumeMode

  params:
    reposerver.parallelism.limit: "2"
    controller.status.processors: "20"
    controller.operation.processors: "10"
    server.insecure: true

  rbac:
    policy.default: "role:readonly"
    policy.csv: |
      {% for user in managed_users if user.argocd_admin | default(false) %}
      g, {{ user.name }}, role:admin
      {% endfor %}

server:
  ingress:
    enabled: true
    ingressClassName: traefik
    hosts:
      - argocd.local
      - argocd.chalupatech.com
