// Grafana Alloy config for the gemini-review GitHub Actions job.
//
// Pipeline:
//   Gemini CLI  ──OTLP HTTP──▶  Alloy (otelcol.receiver.otlp)
//                                 │
//                                 ├── metrics ──▶ VictoriaMetrics (prometheus.remote_write)
//                                 └── logs    ──▶ (dropped for phase-39c; wired in phase-44)
//
// Auth: BasicAuth via TELEMETRY_TOKEN env (see
// docs/runbooks/gh-actions-telemetry-token-rotation.md).
//
// Extracted into a reusable composite action in phase-44.

logging {
  level  = "info"
  format = "logfmt"
}

otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  output {
    metrics = [otelcol.processor.resourcedetection.default.input]
    logs    = [otelcol.processor.resourcedetection.default.input]
    traces  = []
  }
}

// Stamp every signal with CI context so dashboards can slice by run/repo/workflow.
otelcol.processor.resourcedetection "default" {
  detectors = ["env", "system"]
  timeout   = "2s"

  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  send_batch_size = 512
  timeout         = "5s"

  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    // logs intentionally sink to nowhere in phase-39c;
    // phase-44 will wire otelcol.exporter.otlphttp → VictoriaLogs.
    logs = []
  }
}

// Translate OTel metrics to Prometheus exposition, then remote_write to VM.
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.vm.receiver]
}

prometheus.remote_write "vm" {
  endpoint {
    url = sys.env("VM_WRITE_URL")

    basic_auth {
      username = "gh-actions"
      password = sys.env("TELEMETRY_TOKEN")
    }

    // CI jobs are short-lived; drain quickly on shutdown.
    queue_config {
      capacity            = 2500
      max_shards          = 2
      max_samples_per_send = 500
    }
  }

  external_labels = {
    // These become the default `job`/`instance` replacements; actual
    // gen_ai.* labels arrive on the metric itself via Gemini CLI.
    source = "gh-actions",
  }
}
