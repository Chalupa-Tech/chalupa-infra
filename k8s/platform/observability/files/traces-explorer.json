{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Services Reporting",
      "description": "Number of services sending traces to VictoriaTraces",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "jaeger", "uid": "${DS_JAEGER}" },
      "targets": [
        {
          "refId": "A",
          "queryType": "search",
          "service": "$service",
          "limit": 20
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": ["count"]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "title": "Recent Traces",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "title": "Trace Search",
      "description": "Recent traces filtered by service. Click a Trace ID to view the full trace waterfall.",
      "type": "traces",
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "jaeger", "uid": "${DS_JAEGER}" },
      "targets": [
        {
          "refId": "A",
          "queryType": "search",
          "service": "$service",
          "operation": "$operation",
          "limit": 20
        }
      ]
    },
    {
      "title": "Service Map",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": true,
      "panels": [
        {
          "title": "Service Dependencies",
          "description": "Service map requires cross-service trace propagation. Currently, Go services produce independent traces. Enable W3C trace context propagation between services to populate this view.",
          "type": "text",
          "gridPos": { "h": 4, "w": 24, "x": 0, "y": 23 },
          "options": {
            "mode": "markdown",
            "content": "### Service Map Not Yet Available\n\nThe service dependency graph requires **cross-service trace propagation**. Currently, each Go service produces independent traces without shared trace context.\n\n**To enable:**\n1. Add W3C `traceparent` header propagation between services\n2. Ensure HTTP clients inject and servers extract trace context\n3. Once inter-service spans share trace IDs, the dependency graph will populate automatically"
          }
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["traces", "observability", "jaeger"],
  "templating": {
    "list": [
      {
        "name": "DS_JAEGER",
        "type": "datasource",
        "query": "jaeger",
        "current": {},
        "hide": 0
      },
      {
        "name": "service",
        "type": "query",
        "datasource": { "type": "jaeger", "uid": "${DS_JAEGER}" },
        "query": "",
        "queryType": "getServices",
        "refresh": 1,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "hide": 0
      },
      {
        "name": "operation",
        "type": "query",
        "datasource": { "type": "jaeger", "uid": "${DS_JAEGER}" },
        "query": "$service",
        "queryType": "getOperations",
        "refresh": 1,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Traces / Explorer",
  "uid": "traces-explorer"
}
