{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Trace Search",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Recent Traces",
      "description": "Traces from VictoriaTraces via Jaeger API. Click a Trace ID to view the waterfall below.",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 1 },
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://victoria-traces-vt-single-server.observability.svc.cluster.local:10428/select/jaeger/api/traces?service=${service}&limit=${limit}",
          "url_options": { "method": "GET" },
          "parser": "backend",
          "root_selector": "data",
          "columns": [
            { "selector": "traceID", "text": "Trace ID", "type": "string" },
            { "selector": "spans.0.operationName", "text": "Operation", "type": "string" },
            { "selector": "spans.0.duration", "text": "Duration (μs)", "type": "number" }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Trace ID" },
            "properties": [
              { "id": "links", "value": [
                {
                  "title": "View Trace Waterfall",
                  "url": "/d/traces-explorer?var-trace_id=${__data.fields[\"Trace ID\"]}&var-service=${service}&var-limit=${limit}",
                  "targetBlank": false
                }
              ]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Duration (μs)" },
            "properties": [
              { "id": "unit", "value": "µs" }
            ]
          }
        ]
      }
    },
    {
      "title": "Trace Detail",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "collapsed": false
    },
    {
      "title": "Trace Waterfall",
      "description": "Paste a Trace ID or click one from the table above to view the span waterfall.",
      "type": "traces",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "jaeger", "uid": "victoriatraces" },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceID",
          "query": "$trace_id"
        }
      ]
    },
    {
      "title": "Service Map",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": true,
      "panels": [
        {
          "title": "Service Dependencies",
          "type": "text",
          "gridPos": { "h": 4, "w": 24, "x": 0, "y": 27 },
          "options": {
            "mode": "markdown",
            "content": "### Service Map Not Yet Available\n\nThe service dependency graph requires **cross-service trace propagation**. Currently, each Go service produces independent traces.\n\n**To enable:** Add W3C `traceparent` header propagation between services."
          }
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["traces", "observability", "jaeger", "kubernetes"],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "query": "go-notify,go-schwab-auth,go-telemetry-mesh",
        "current": { "text": "go-telemetry-mesh", "value": "go-telemetry-mesh" },
        "hide": 0
      },
      {
        "name": "limit",
        "type": "custom",
        "query": "20,50,100",
        "current": { "text": "20", "value": "20" },
        "hide": 0
      },
      {
        "name": "trace_id",
        "type": "textbox",
        "current": { "text": "", "value": "" },
        "hide": 0,
        "label": "Trace ID"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Traces / Explorer",
  "uid": "traces-explorer"
}
