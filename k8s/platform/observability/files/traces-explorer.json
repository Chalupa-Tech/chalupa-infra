{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Trace Search",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "title": "Recent Traces",
      "description": "Traces from VictoriaTraces via Jaeger API. Click a Trace ID to view the trace waterfall.",
      "type": "table",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "infinity"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://victoria-traces-vt-single-server.observability.svc.cluster.local:10428/select/jaeger/api/traces?service=${service}&limit=${limit}",
          "url_options": {
            "method": "GET"
          },
          "parser": "backend",
          "root_selector": "data",
          "columns": [
            {
              "selector": "traceID",
              "text": "Trace ID",
              "type": "string"
            },
            {
              "selector": "spans.0.operationName",
              "text": "Operation",
              "type": "string"
            },
            {
              "selector": "spans.0.duration",
              "text": "Duration (\u03bcs)",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Trace ID"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View Trace Waterfall",
                    "url": "/d/trace-detail?var-traceId=${__value.raw}&from=${__from}&to=${__to}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration (\u03bcs)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "\u00b5s"
              }
            ]
          }
        ]
      }
    },
    {
      "title": "Service Map",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "collapsed": true,
      "panels": [
        {
          "title": "Service Dependencies",
          "type": "text",
          "gridPos": {
            "h": 4,
            "w": 24,
            "x": 0,
            "y": 16
          },
          "options": {
            "mode": "markdown",
            "content": "### Service Map Not Yet Available\n\nThe service dependency graph requires **cross-service trace propagation**. Currently, each Go service produces independent traces.\n\n**To enable:** Add W3C `traceparent` header propagation between services."
          }
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "traces",
    "observability",
    "jaeger",
    "kubernetes"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_VM",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_VM}"
        },
        "query": {
          "query": "label_values(traces_span_metrics_duration_milliseconds_count, service_name)",
          "refId": "A"
        },
        "definition": "label_values(traces_span_metrics_duration_milliseconds_count, service_name)",
        "refresh": 1,
        "current": {},
        "hide": 0
      },
      {
        "name": "limit",
        "type": "custom",
        "query": "20,50,100",
        "current": {
          "text": "20",
          "value": "20"
        },
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Traces / Explorer",
  "uid": "traces-explorer",
  "links": [
    {
      "title": "Cluster Overview",
      "type": "link",
      "url": "/d/cluster-overview",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Logs Explorer",
      "type": "link",
      "url": "/d/victorialogs-explorer",
      "icon": "doc",
      "targetBlank": false
    },
    {
      "title": "Service RED",
      "type": "link",
      "url": "/d/service-red",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Schwab Feed",
      "type": "link",
      "url": "/d/schwab-feed",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Trading Dashboard",
      "type": "link",
      "url": "/d/schwab-trading",
      "icon": "graph-bar",
      "targetBlank": false
    }
  ]
}
