{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "uid": "etcd-overview",
  "title": "etcd Overview",
  "tags": [
    "kubernetes",
    "etcd",
    "control-plane"
  ],
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_VM",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "title": "Health",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "title": "etcd Members Up",
      "description": "Number of etcd members that currently have a leader. If below cluster size, quorum may be at risk.",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(etcd_server_has_leader == 1)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "title": "Leader",
      "description": "Which etcd member is the current Raft leader",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "etcd_server_is_leader == 1",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Leader",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "options": {
        "graphMode": "none",
        "textMode": "name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "title": "DB Size",
      "description": "Total etcd database size per member",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "etcd_mvcc_db_total_size_in_bytes",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 524288000
              },
              {
                "color": "red",
                "value": 1073741824
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "title": "DB Size In Use",
      "description": "Actual data size in use (after compaction) per member",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "etcd_mvcc_db_total_size_in_use_in_bytes",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 524288000
              },
              {
                "color": "red",
                "value": 1073741824
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "title": "Performance",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "collapsed": false
    },
    {
      "title": "WAL Fsync Duration p99",
      "description": "99th percentile write-ahead log fsync latency. High values indicate disk I/O pressure.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, rate(etcd_disk_wal_fsync_duration_seconds_bucket[5m]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "connectNulls": true
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "title": "Backend Commit Duration p99",
      "description": "99th percentile backend commit latency. Sustained high values indicate storage bottleneck.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, rate(etcd_disk_backend_commit_duration_seconds_bucket[5m]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10,
            "connectNulls": true
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "title": "Disk Space Used",
      "description": "etcd database size over time per member",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "etcd_mvcc_db_total_size_in_bytes",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "connectNulls": true
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "title": "Operations",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "collapsed": false
    },
    {
      "title": "Key Count",
      "description": "Total number of keys stored in etcd",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "etcd_debugging_mvcc_keys_total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "title": "Request Rate by Type",
      "description": "Rate of etcd requests broken down by operation type (range, put, delete, txn)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 6,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(etcd_request_duration_seconds_count[5m])",
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "connectNulls": true
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "title": "Failed gRPC Requests",
      "description": "Rate of gRPC requests with non-OK status codes",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 15,
        "y": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(grpc_server_handled_total{grpc_code!=\"OK\"}[5m])",
          "legendFormat": "{{grpc_method}} {{grpc_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "connectNulls": true
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "title": "Cluster",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "collapsed": false
    },
    {
      "title": "Peer Traffic",
      "description": "Bytes sent and received between etcd cluster peers",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(etcd_network_peer_sent_bytes_total[5m])",
          "legendFormat": "{{instance}} sent"
        },
        {
          "refId": "B",
          "expr": "rate(etcd_network_peer_received_bytes_total[5m])",
          "legendFormat": "{{instance}} received"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 10,
            "connectNulls": true
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "title": "Raft Proposals",
      "description": "Raft consensus proposals: committed, applied, pending, and failed. Failed proposals indicate cluster health issues.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(etcd_server_proposals_committed_total[5m])",
          "legendFormat": "committed/s"
        },
        {
          "refId": "B",
          "expr": "rate(etcd_server_proposals_applied_total[5m])",
          "legendFormat": "applied/s"
        },
        {
          "refId": "C",
          "expr": "etcd_server_proposals_pending",
          "legendFormat": "pending"
        },
        {
          "refId": "D",
          "expr": "rate(etcd_server_proposals_failed_total[5m])",
          "legendFormat": "failed/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "connectNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "failed/s"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "pending"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "title": "Leader Changes",
      "description": "Total number of leader changes seen. Frequent changes indicate instability.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_VM}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "changes(etcd_server_leader_changes_seen_total[1h])",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "connectNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "links": [
    {
      "title": "Cluster Overview",
      "type": "link",
      "url": "/d/cluster-overview",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Logs Explorer",
      "type": "link",
      "url": "/d/victorialogs-explorer",
      "icon": "doc",
      "targetBlank": false
    },
    {
      "title": "Traces Explorer",
      "type": "link",
      "url": "/d/traces-explorer",
      "icon": "bolt",
      "targetBlank": false
    },
    {
      "title": "Service RED",
      "type": "link",
      "url": "/d/service-red",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Schwab Feed",
      "type": "link",
      "url": "/d/schwab-feed",
      "icon": "dashboard",
      "targetBlank": false
    },
    {
      "title": "Trading Dashboard",
      "type": "link",
      "url": "/d/schwab-trading",
      "icon": "graph-bar",
      "targetBlank": false
    }
  ]
}
