      "url": "/d/cluster-overview"
    },
    {
      "asDropdown": false,
      "icon": "doc",
      "includeVars": false,
      "keepTime": false,
      "placement": "inControlsMenu",
      "tags": [],
      "targetBlank": false,
      "title": "Logs Explorer",
      "tooltip": "",
      "type": "link",
      "url": "/d/victorialogs-explorer"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": [],
      "title": "Longhorn",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Per Longhorn volume: healthy, degraded (a replica is not healthy; LonghornVolumeDegraded after 30m) or faulted (no healthy replica; LonghornVolumeFaulted pages after 2m). Unknown is a detached volume.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "text",
                  "text": "Unknown"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": {
                  "color": "green",
                  "text": "Healthy"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "2": {
                  "color": "orange",
                  "text": "Degraded"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "3": {
                  "color": "red",
                  "text": "Faulted"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 101,
      "options": {
        "alignValue": "left",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "mergeValues": true,
        "perPage": 20,
        "rowHeight": 0.8,
        "showValue": "never",
        "tooltip": {
          "mode": "",
          "sort": ""
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "max by (pvc_namespace, pvc) (longhorn_volume_robustness)",
          "legendFormat": "{{pvc_namespace}}/{{pvc}}",
          "refId": "A"
        }
      ],
      "title": "Volume robustness",
      "transparent": false,
      "type": "state-timeline"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Lines per second from longhorn-manager, per node, counted by Vector. LonghornManagerLogFlood fires above 100/s for 10m; on 2026-11-17 the replay loop reached about 2,200/s.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "id": 102,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": ""
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum by (node) (rate(vector_pod_log_lines_total{log_namespace=\"longhorn-system\", log_container=\"longhorn-manager\"}[5m]))",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ],
      "title": "longhorn-manager log lines/s",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "\"format of disk\" lines from longhorn-csi-plugin in the selected range: mkfs failed, or the phase-97 guard refused a volume that holds data. LonghornFormatRefusedOrFailed pages on any.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "none seen",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 7
      },
      "id": 103,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum by (volume) (increase(vector_longhorn_csi_format_failures_total[$__range]))",
          "legendFormat": "{{volume}}",
          "refId": "A"
        }
      ],
      "title": "CSI format failures",
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Time since the longhorn-mkfs-guard CronJob (every 5m) last succeeded. It re-applies the guard after a Longhorn upgrade; LonghornMkfsGuardNotApplied fires past 30m.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 600
              },
              {
                "color": "red",
                "value": 1800
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 7
      },
      "id": 104,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "time() - max(kube_cronjob_status_last_successful_time{namespace=\"longhorn-system\", cronjob=\"longhorn-mkfs-guard\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "mkfs guard: since last success",
      "transparent": false,
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 200,
      "panels": [],
      "title": "Log pipeline",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Rows per second VictoriaLogs ingested, and LogIngestSpike's threshold: 10x the 1-day median, never below 100. The alert needs 15m above it.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 201,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": ""
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "sum(rate(vl_rows_ingested_total[5m]))",
          "legendFormat": "ingested",
          "refId": "A"
        },
        {
          "expr": "clamp_min(10 * quantile_over_time(0.5, sum(rate(vl_rows_ingested_total[5m]))[1d:5m]), 100)",
          "legendFormat": "alert threshold",
          "refId": "B"
        }
      ],
      "title": "VictoriaLogs ingest (rows/s)",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "The ten busiest namespace/container pairs by lines per second, as counted by Vector on each node.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 202,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": ""
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "topk(10, sum by (node, log_namespace, log_container) (rate(vector_pod_log_lines_total[5m])))",
          "legendFormat": "{{log_namespace}}/{{log_container}} ({{node}})",
          "refId": "A"
        }
      ],
      "title": "Top log streams (lines/s)",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "CPU of Vector, VictoriaLogs and longhorn-manager per pod. On 2026-11-17 these went from about 0.05 to 2.9 cores together on a 4-core node.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 203,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": ""
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "max by (pod, container) (rate(container_cpu_usage_seconds_total{namespace=~\"observability|longhorn-system\", container=~\"vector|vlogs|longhorn-manager\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Log pipeline CPU (cores)",
      "transparent": false,
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "description": "Bytes vmagent holds for vmsingle. After a vmsingle outage it replays oldest-first, so recent data is missing until this drains; MetricsPipelineStale fires above 64 MiB for 10m.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 67108864
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 204,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": ""
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "max(vm_persistentqueue_bytes_pending)",
          "legendFormat": "pending",
          "refId": "A"
        }
      ],
      "title": "vmagent queue pending",
      "transparent": false,
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 42,
  "tags": [
