{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "",
      "type": "text",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "[< Back to Traces Explorer](/d/traces-explorer?from=${__from}&to=${__to}) &nbsp;|&nbsp; [< Back to Service RED](/d/service-red?from=${__from}&to=${__to})"
      },
      "transparent": true
    },
    {
      "title": "Trace Waterfall",
      "type": "traces",
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 2
      },
      "datasource": {
        "type": "jaeger",
        "uid": "victoriatraces"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "jaeger",
            "uid": "victoriatraces"
          },
          "query": "${traceId}"
        }
      ]
    },
    {
      "title": "Correlated Logs",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "collapsed": false
    },
    {
      "title": "Logs for this Trace",
      "description": "Log entries correlated by trace_id from VictoriaLogs",
      "type": "logs",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "trace_id:=\"${traceId}\" | sort by (_time) desc | limit 200",
          "queryType": "instant"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "traces",
    "observability"
  ],
  "templating": {
    "list": [
      {
        "name": "traceId",
        "type": "textbox",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "label": "Trace ID"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
