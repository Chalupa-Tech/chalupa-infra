{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "uid": "scheduler",
  "title": "Scheduler",
  "tags": ["kubernetes", "scheduler", "control-plane"],
  "time": { "from": "now-3h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_VM",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "title": "Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Scheduling Latency p99",
      "description": "99th percentile scheduling attempt duration — how long it takes the scheduler to find a node for a pod.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, rate(scheduler_scheduling_attempt_duration_seconds_bucket{job=~\".*k3s-scheduler.*\"}[5m]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10, "connectNulls": true }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Scheduling Attempts",
      "description": "Rate of scheduling attempts by result: scheduled, unschedulable, or error.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(scheduler_schedule_attempts_total{job=~\".*k3s-scheduler.*\"}[5m])",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "fillOpacity": 10, "connectNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "unschedulable" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Queue",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "title": "Pending Pods",
      "description": "Number of pending pods in the scheduler queue, broken down by queue type.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "scheduler_pending_pods{job=~\".*k3s-scheduler.*\"}",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "connectNulls": true },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Scheduling Duration by Extension Point",
      "description": "99th percentile scheduling plugin/extension point latency.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, rate(scheduler_framework_extension_point_duration_seconds_bucket{job=~\".*k3s-scheduler.*\"}[5m]))",
          "legendFormat": "{{extension_point}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10, "connectNulls": true }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Preemption Attempts",
      "description": "Rate of scheduling preemption attempts — when the scheduler evicts lower-priority pods to place higher-priority ones.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(scheduler_preemption_attempts_total{job=~\".*k3s-scheduler.*\"}[5m])",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "fillOpacity": 10, "connectNulls": true }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "API Client",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "title": "REST Client Requests",
      "description": "Rate of outbound REST client requests from the scheduler to the API server, by status code.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(rest_client_requests_total{job=~\".*k3s-scheduler.*\"}[5m])",
          "legendFormat": "{{code}} {{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "fillOpacity": 10, "connectNulls": true }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Request Duration p99",
      "description": "99th percentile latency of outbound REST client requests from the scheduler to the API server.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, rate(rest_client_request_duration_seconds_bucket{job=~\".*k3s-scheduler.*\"}[5m]))",
          "legendFormat": "{{url}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10, "connectNulls": true }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    }
  ]
}
