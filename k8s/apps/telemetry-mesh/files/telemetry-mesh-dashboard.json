{
  "annotations": { "list": [] },
  "editable": true,
  "title": "Telemetry Mesh",
  "uid": "telemetry-mesh",
  "tags": ["telemetry", "mesh", "network"],
  "templating": {
    "list": [
      {
        "name": "DS_VM",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "VictoriaMetrics", "value": "VictoriaMetrics" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "title": "Overview",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Cluster Health",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "min(telemetry_mesh_cluster_healthy)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Unhealthy" }, "1": { "text": "Healthy" } } }
          ]
        }
      }
    },
    {
      "title": "Total Nodes",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(telemetry_mesh_peers_discovered) + 1"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Avg Latency",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(rate(telemetry_mesh_probe_duration_seconds_sum[5m]) / rate(telemetry_mesh_probe_duration_seconds_count[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.001 },
              { "color": "red", "value": 0.005 }
            ]
          }
        }
      }
    },
    {
      "title": "Probe Success Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(telemetry_mesh_probe_total{result=\"success\"}[5m])) / sum(rate(telemetry_mesh_probe_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          }
        }
      }
    },
    {
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(telemetry_mesh_probe_errors_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Peers Discovered",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(telemetry_mesh_peers_discovered)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Site Latency",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "title": "Intra-site: tpi",
      "description": "Avg latency between tpi nodes (site-tpi)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(rate(telemetry_mesh_probe_duration_seconds_sum{source_node=~\"tpi.*\",target_node=~\"tpi.*\"}[5m]) / rate(telemetry_mesh_probe_duration_seconds_count{source_node=~\"tpi.*\",target_node=~\"tpi.*\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.001 },
              { "color": "red", "value": 0.005 }
            ]
          }
        }
      }
    },
    {
      "title": "Intra-site: dpi",
      "description": "Avg latency between dpi/fw nodes (site-dpi)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(rate(telemetry_mesh_probe_duration_seconds_sum{source_node=~\"dpi.*|fw.*\",target_node=~\"dpi.*|fw.*\"}[5m]) / rate(telemetry_mesh_probe_duration_seconds_count{source_node=~\"dpi.*|fw.*\",target_node=~\"dpi.*|fw.*\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.001 },
              { "color": "red", "value": 0.005 }
            ]
          }
        }
      }
    },
    {
      "title": "Cross-site Avg",
      "description": "Avg latency between site-tpi and site-dpi",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(rate(telemetry_mesh_probe_duration_seconds_sum{source_node=~\"tpi.*\",target_node=~\"dpi.*|fw.*\"}[5m]) / rate(telemetry_mesh_probe_duration_seconds_count{source_node=~\"tpi.*\",target_node=~\"dpi.*|fw.*\"}[5m]) or rate(telemetry_mesh_probe_duration_seconds_sum{source_node=~\"dpi.*|fw.*\",target_node=~\"tpi.*\"}[5m]) / rate(telemetry_mesh_probe_duration_seconds_count{source_node=~\"dpi.*|fw.*\",target_node=~\"tpi.*\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.001 },
              { "color": "red", "value": 0.005 }
            ]
          }
        }
      }
    },
    {
      "title": "Cross-site P99",
      "description": "P99 latency between site-tpi and site-dpi",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(telemetry_mesh_probe_duration_seconds_bucket{source_node=~\"tpi.*\",target_node=~\"dpi.*|fw.*\"}[5m]) or rate(telemetry_mesh_probe_duration_seconds_bucket{source_node=~\"dpi.*|fw.*\",target_node=~\"tpi.*\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.002 },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      }
    },
    {
      "title": "Site Latency Over Time",
      "description": "Avg latency by path: intra-tpi, intra-dpi, cross-site",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(rate(telemetry_mesh_probe_duration_seconds_sum{source_node=~\"tpi.*\",target_node=~\"tpi.*\"}[5m]) / rate(telemetry_mesh_probe_duration_seconds_count{source_node=~\"tpi.*\",target_node=~\"tpi.*\"}[5m]))",
          "legendFormat": "intra: site-tpi"
        },
        {
          "refId": "B",
          "expr": "avg(rate(telemetry_mesh_probe_duration_seconds_sum{source_node=~\"dpi.*|fw.*\",target_node=~\"dpi.*|fw.*\"}[5m]) / rate(telemetry_mesh_probe_duration_seconds_count{source_node=~\"dpi.*|fw.*\",target_node=~\"dpi.*|fw.*\"}[5m]))",
          "legendFormat": "intra: site-dpi"
        },
        {
          "refId": "C",
          "expr": "avg(rate(telemetry_mesh_probe_duration_seconds_sum{source_node=~\"tpi.*\",target_node=~\"dpi.*|fw.*\"}[5m]) / rate(telemetry_mesh_probe_duration_seconds_count{source_node=~\"tpi.*\",target_node=~\"dpi.*|fw.*\"}[5m]) or rate(telemetry_mesh_probe_duration_seconds_sum{source_node=~\"dpi.*|fw.*\",target_node=~\"tpi.*\"}[5m]) / rate(telemetry_mesh_probe_duration_seconds_count{source_node=~\"dpi.*|fw.*\",target_node=~\"tpi.*\"}[5m]))",
          "legendFormat": "cross-site"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10 }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Cross-site Latency Distribution",
      "description": "Histogram heatmap of latency between site-tpi and site-dpi",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(telemetry_mesh_probe_duration_seconds_bucket{source_node=~\"tpi.*\",target_node=~\"dpi.*|fw.*\"}[5m]) or rate(telemetry_mesh_probe_duration_seconds_bucket{source_node=~\"dpi.*|fw.*\",target_node=~\"tpi.*\"}[5m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "options": {
        "color": {
          "scheme": "Greens",
          "mode": "scheme"
        },
        "yAxis": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Mesh Topology",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "title": "Cluster Mesh — Node Graph",
      "description": "Force-directed mesh topology. Edge thickness = latency. Nodes auto-discovered from probe pairs.",
      "type": "nodeGraph",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "nodes",
          "expr": "label_replace(label_replace(avg by (source_node) (rate(telemetry_mesh_probe_duration_seconds_sum[5m]) / rate(telemetry_mesh_probe_duration_seconds_count[5m])), \"id\", \"$1\", \"source_node\", \"(.*)\"), \"title\", \"$1\", \"source_node\", \"(.*)\")",
          "format": "table",
          "instant": true
        },
        {
          "refId": "edges",
          "expr": "label_join(label_join(label_join(avg by (source_node, target_node) (rate(telemetry_mesh_probe_duration_seconds_sum[5m]) / rate(telemetry_mesh_probe_duration_seconds_count[5m])), \"id\", \"-\", \"source_node\", \"target_node\"), \"source\", \"\", \"source_node\"), \"target\", \"\", \"target_node\")",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "source_node": true, "target_node": true },
            "renameByName": { "Value #nodes": "mainStat", "Value #edges": "mainStat" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "mainStat" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 4 }
            ]
          }
        ]
      },
      "options": {
        "nodes": {
          "mainStatUnit": "s"
        },
        "edges": {
          "mainStatUnit": "s"
        }
      }
    },
    {
      "title": "Node-to-Node Latency Matrix",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "collapsed": false
    },
    {
      "title": "Avg Latency — Source x Target",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (source_node, target_node) (rate(telemetry_mesh_probe_duration_seconds_sum[5m]) / rate(telemetry_mesh_probe_duration_seconds_count[5m]))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "source_node": "Source", "target_node": "Target", "Value": "Latency (s)" }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "align": "center" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.001 },
              { "color": "red", "value": 0.005 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Source" },
            "properties": [{ "id": "custom.width", "value": 150 }]
          },
          {
            "matcher": { "id": "byName", "options": "Target" },
            "properties": [{ "id": "custom.width", "value": 150 }]
          }
        ]
      }
    },
    {
      "title": "Timeseries",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 },
      "collapsed": false
    },
    {
      "title": "Latency by Node Pair",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 45 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (source_node, target_node) (rate(telemetry_mesh_probe_duration_seconds_sum[5m]) / rate(telemetry_mesh_probe_duration_seconds_count[5m]))",
          "legendFormat": "{{source_node}} → {{target_node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10 }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Error Rate by Pair",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 45 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source_node, target_node) (rate(telemetry_mesh_probe_errors_total[5m]))",
          "legendFormat": "{{source_node}} → {{target_node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "fillOpacity": 10 }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Deep Dive",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 53 },
      "collapsed": false
    },
    {
      "title": "P99 Latency by Node Pair",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (source_node, target_node, le) (rate(telemetry_mesh_probe_duration_seconds_bucket[5m])))",
          "legendFormat": "{{source_node}} → {{target_node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10 }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "title": "Node Health State",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "${DS_VM}" },
      "targets": [
        {
          "refId": "A",
          "expr": "telemetry_mesh_cluster_healthy",
          "legendFormat": "{{source_node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Unhealthy", "color": "red" }, "1": { "text": "Healthy", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    }
  ],
  "schemaVersion": 39
}
