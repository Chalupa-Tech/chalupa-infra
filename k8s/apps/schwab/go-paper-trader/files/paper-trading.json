  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "symbol",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "query": "SELECT DISTINCT symbol FROM paper_positions ORDER BY symbol",
        "rawSql": "SELECT DISTINCT symbol FROM paper_positions ORDER BY symbol",
        "definition": "SELECT DISTINCT symbol FROM paper_positions ORDER BY symbol",
        "multi": true,
        "includeAll": true,
        "current": {},
        "refresh": 1
      },
      {
        "name": "strategy",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescaledb"
        },
        "query": "SELECT DISTINCT strategy FROM paper_fills ORDER BY strategy",
        "rawSql": "SELECT DISTINCT strategy FROM paper_fills ORDER BY strategy",
        "definition": "SELECT DISTINCT strategy FROM paper_fills ORDER BY strategy",
