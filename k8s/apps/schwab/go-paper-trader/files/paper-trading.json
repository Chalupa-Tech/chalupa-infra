    {
      "id": 14,
      "type": "stat",
      "title": "Notional traded",
      "description": "sum(quantity × price) across all fills in the time range. A rough measure of capital turnover — high notional on a low-cash book means the book is churning (buying + selling rapidly), which usually means slippage tax is the dominant P&L driver.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 48
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT SUM(quantity * price) AS notional FROM paper_fills WHERE $__timeFilter(time) AND strategy IN ($strategy) AND book_id IN ($book_id)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
