    {
      "id": 20,
      "type": "timeseries",
      "title": "Cumulative realized P&L by book",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT time, book_id AS metric, SUM(realized_pl) OVER (PARTITION BY book_id ORDER BY time) AS cumulative_realized_pl FROM paper_fills WHERE realized_pl IS NOT NULL AND $__timeFilter(time) AND book_id IN ($book_id) ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
