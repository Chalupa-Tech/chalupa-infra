    {
      "id": 6,
      "type": "timeseries",
      "title": "Drawdown % by book (peak-to-trough)",
      "description": "Current drawdown from the running peak of paper_equity_usd within the visible time range. Computed in VictoriaMetrics (continuous scrape) rather than from paper_cash/paper_positions snapshots, which only emit on change and produced sparse data in the SQL version. Per series: 100 × (equity − running_max(equity)) / running_max(equity). 0% means at-or-above peak; negative values are the live drawdown.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (paper_equity_usd{book_id=~\"$book_id\"} - running_max(paper_equity_usd{book_id=~\"$book_id\"})) / running_max(paper_equity_usd{book_id=~\"$book_id\"})",
          "legendFormat": "{{book_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
