{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "title": "Schwab Argo Rollouts",
  "uid": "schwab-rollouts",
  "tags": [
    "schwab",
    "rollouts",
    "canary"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "constant",
        "query": "schwab-ddowell",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "title": "Rollout Phase",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "Healthy", "color": "green" } } },
            { "type": "value", "options": { "2": { "text": "Progressing", "color": "yellow" } } },
            { "type": "value", "options": { "3": { "text": "Degraded", "color": "red" } } },
            { "type": "value", "options": { "4": { "text": "Paused", "color": "blue" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "label_replace(\n  (kube_customresource_rollout_info{namespace=\"$namespace\"} * 0 + 1)\n  * on(customresource_name) group_left()\n  (\n    (kube_customresource_rollout_phase{namespace=\"$namespace\", phase=\"Healthy\"} == 1) * 1\n    or\n    (kube_customresource_rollout_phase{namespace=\"$namespace\", phase=\"Progressing\"} == 1) * 2\n    or\n    (kube_customresource_rollout_phase{namespace=\"$namespace\", phase=\"Degraded\"} == 1) * 3\n    or\n    (kube_customresource_rollout_phase{namespace=\"$namespace\", phase=\"Paused\"} == 1) * 4\n  ),\n  \"service\", \"$1\", \"customresource_name\", \"(.*)\"\n)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "datasource": "VictoriaMetrics"
    },
    {
      "title": "AnalysisRun Results",
      "type": "state-timeline",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Running", "color": "yellow" } } },
            { "type": "value", "options": { "1": { "text": "Successful", "color": "green" } } },
            { "type": "value", "options": { "2": { "text": "Failed", "color": "red" } } },
            { "type": "value", "options": { "3": { "text": "Inconclusive", "color": "orange" } } },
            { "type": "value", "options": { "4": { "text": "Error", "color": "dark-red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "transparent" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "alignValue": "left"
      },
      "targets": [
        {
          "expr": "label_replace(\n  (\n    (kube_customresource_analysisrun_phase{namespace=\"$namespace\", phase=\"Running\"} == 1) * 0\n    or\n    (kube_customresource_analysisrun_phase{namespace=\"$namespace\", phase=\"Successful\"} == 1) * 1\n    or\n    (kube_customresource_analysisrun_phase{namespace=\"$namespace\", phase=\"Failed\"} == 1) * 2\n    or\n    (kube_customresource_analysisrun_phase{namespace=\"$namespace\", phase=\"Inconclusive\"} == 1) * 3\n    or\n    (kube_customresource_analysisrun_phase{namespace=\"$namespace\", phase=\"Error\"} == 1) * 4\n  ),\n  \"run\", \"$1\", \"customresource_name\", \"(.*)\"\n)",
          "legendFormat": "{{run}}",
          "refId": "A"
        }
      ],
      "datasource": "VictoriaMetrics"
    },
    {
      "title": "Pod Up Status (per pod)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "decimals": 0,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "up{namespace=\"$namespace\", pod=~\"go-schwab-auth-.*|go-schwab-feed-.*|go-notify-subscriber-.*\"}",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "datasource": "VictoriaMetrics"
    },
    {
      "title": "Container Restarts (per pod)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=~\"go-schwab-auth-.*|go-schwab-feed-.*|go-notify-subscriber-.*\"}",
          "legendFormat": "{{pod}} / {{container}}",
          "refId": "A"
        }
      ],
      "datasource": "VictoriaMetrics"
    },
    {
      "title": "Canary vs Stable Restarts (rate/5m)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "red" }
            ]
          },
          "custom": {
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=~\"go-schwab-auth-.*|go-schwab-feed-.*|go-notify-subscriber-.*\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "datasource": "VictoriaMetrics"
    },
    {
      "title": "Rollout Replicas",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": { "mode": "none" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "kube_pod_status_ready{namespace=\"$namespace\", pod=~\"go-schwab-auth-.*|go-schwab-feed-.*|go-notify-subscriber-.*\", condition=\"true\"}",
          "legendFormat": "{{pod}} ready",
          "refId": "A"
        },
        {
          "expr": "kube_pod_status_phase{namespace=\"$namespace\", pod=~\"go-schwab-auth-.*|go-schwab-feed-.*|go-notify-subscriber-.*\", phase=\"Running\"} == 1",
          "legendFormat": "{{pod}} running",
          "refId": "B"
        }
      ],
      "datasource": "VictoriaMetrics"
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
