{
  "annotations": {},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "1": {
                  "color": "green",
                  "text": "Completed"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "2": {
                  "color": "yellow",
                  "text": "Progressing"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "3": {
                  "color": "blue",
                  "text": "Paused"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "4": {
                  "color": "red",
                  "text": "Abort"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "5": {
                  "color": "dark-red",
                  "text": "Error"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "6": {
                  "color": "orange",
                  "text": "Timeout"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "",
        "percentChangeColorMode": "standard",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(rollout_phase{exported_namespace=\"$namespace\", phase=\"Completed\"} == 1) * 1\nor\n(rollout_phase{exported_namespace=\"$namespace\", phase=\"Progressing\"} == 1) * 2\nor\n(rollout_phase{exported_namespace=\"$namespace\", phase=\"Paused\"} == 1) * 3\nor\n(rollout_phase{exported_namespace=\"$namespace\", phase=\"Abort\"} == 1) * 4\nor\n(rollout_phase{exported_namespace=\"$namespace\", phase=\"Error\"} == 1) * 5\nor\n(rollout_phase{exported_namespace=\"$namespace\", phase=\"Timeout\"} == 1) * 6",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "Rollout Phase",
      "transparent": false,
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "yellow",
                  "text": "Running"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": {
                  "color": "green",
                  "text": "Successful"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "2": {
                  "color": "red",
                  "text": "Failed"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "3": {
                  "color": "orange",
                  "text": "Inconclusive"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "4": {
                  "color": "dark-red",
                  "text": "Error"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
