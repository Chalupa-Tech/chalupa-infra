        "mergeValues": true,
        "perPage": 20,
        "rowHeight": 0.9,
        "showValue": "auto",
        "tooltip": {
          "mode": "",
          "sort": ""
        }
      },
      "repeatDirection": "h",
      "targets": [
        {
          "expr": "(analysis_run_phase{exported_namespace=\"$namespace\", phase=\"Running\"} == 1) * 0\nor\n(analysis_run_phase{exported_namespace=\"$namespace\", phase=\"Successful\"} == 1) * 1\nor\n(analysis_run_phase{exported_namespace=\"$namespace\", phase=\"Failed\"} == 1) * 2\nor\n(analysis_run_phase{exported_namespace=\"$namespace\", phase=\"Inconclusive\"} == 1) * 3\nor\n(analysis_run_phase{exported_namespace=\"$namespace\", phase=\"Error\"} == 1) * 4",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "title": "AnalysisRun Results",
      "transparent": false,
      "type": "state-timeline"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "decimals": 0,
          "max": 1,
          "min": 0,
