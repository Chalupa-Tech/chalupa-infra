    {
      "title": "$symbol Candlestick / SMA-20 / Bollinger",
      "type": "candlestick",
      "gridPos": {
        "h": 14,
        "w": 18,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "rawSql": "SELECT time, open, high, low, close, volume FROM candles WHERE symbol = '$symbol' AND frequency = CASE WHEN $__interval_ms <= 600000 THEN '5m' ELSE '1d' END AND $__timeFilter(time) ORDER BY time",
          "format": "table",
          "refId": "A"
        },
        {
          "rawSql": "SELECT time, AVG(close) OVER (ORDER BY time ROWS BETWEEN 19 PRECEDING AND CURRENT ROW) AS sma20 FROM candles WHERE symbol = '$symbol' AND frequency = CASE WHEN $__interval_ms <= 600000 THEN '5m' ELSE '1d' END AND $__timeFilter(time) ORDER BY time",
          "format": "table",
          "refId": "B"
        },
        {
          "rawSql": "SELECT time, AVG(close) OVER w + 2 * STDDEV(close) OVER w AS bb_upper, AVG(close) OVER w - 2 * STDDEV(close) OVER w AS bb_lower FROM candles WHERE symbol = '$symbol' AND frequency = CASE WHEN $__interval_ms <= 600000 THEN '5m' ELSE '1d' END AND $__timeFilter(time) WINDOW w AS (ORDER BY time ROWS BETWEEN 19 PRECEDING AND CURRENT ROW) ORDER BY time",
          "format": "table",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisSoftMin": null
          },
          "decimals": 2,
          "unit": "currencyUSD"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sma20"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "bb_upper"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "gray",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "bb_lower"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "gray",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash"
                }
              },
              {
                "id": "custom.fillBelowTo",
                "value": "bb_upper"
              },
              {
                "id": "custom.fillOpacity",
                "value": 5
              }
            ]
          }
        ]
      },
      "options": {
        "mode": "both",
        "includeAllFields": true,
        "fields": {
          "open": "open",
          "high": "high",
          "low": "low",
          "close": "close",
          "volume": "volume"
        },
        "colors": {
          "up": "green",
          "down": "red",
          "flat": "gray"
        }
      }
    },
    {
      "title": "$symbol Source Variance",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "rawSql": "SELECT s.time, ABS(s.close - q.close) AS variance, s.close AS schwab_close, q.close AS quote_close FROM candles s JOIN candles q ON s.time = q.time AND s.symbol = q.symbol AND s.frequency = q.frequency WHERE s.source = 'ddowell-individual' AND q.source IN ('quote', 'quote-derived') AND s.symbol = '$symbol' AND s.frequency = '5m' AND $__timeFilter(s.time) ORDER BY s.time",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "variance"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 20
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "schwab_close"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "quote_close"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
