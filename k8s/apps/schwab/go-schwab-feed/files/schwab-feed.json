          "legendFormat": "{{symbol}}",
          "range": false,
          "refId": "A"
        },
        {
          "expr": "max by (symbol) (schwab_quote_change_pct{registration=~\"$registration\", symbol=~\"$symbol\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{symbol}}",
          "range": false,
          "refId": "B"
        },
        {
          "expr": "max by (symbol) (schwab_quote_volume{registration=~\"$registration\", symbol=~\"$symbol\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{symbol}}",
          "range": false,
          "refId": "C"
        }
      ],
      "title": "Quote Prices",
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": {
            "byField": "symbol"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true
            },
            "renameByName": {
              "Value #A": "Price",
              "Value #B": "Change %",
              "Value #C": "Volume"
            }
          }
        }
      ],
      "transparent": false,
      "type": "table"
